# ============================================================
# Telegram Bot
# ============================================================

# Токен бота — получить у @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Username бота без @ (например: myphotobot)
BOT_USERNAME=myphotobot

# Telegram ID владельца — единственный, кто может включать /maintenance
# Узнать свой ID можно у @userinfobot
OWNER_ID=123456789

# Telegram ID администраторов (через запятую в квадратных скобках)
# Они получают доступ к /admin панели
ADMIN_IDS=[123456789]


# ============================================================
# База данных (PostgreSQL)
# ============================================================
DB_NAME=chatbot
DB_USER=chatbot
DB_PASSWORD=strongpassword
DB_HOST=db
DB_PORT=5432


# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://redis:6379/0


# ============================================================
# AI API ключи
# ============================================================

# Nano Banana / Seedream (WaveSpeed API)
# Получить на: https://wavespeed.ai
WAVESPEED_API_KEY=

# Midjourney (midapi.ai)
# Получить на: https://midapi.ai
MIDJOURNEY_API_KEY=


# ============================================================
# ЮКасса (опционально)
# Оставить пустым если используется заглушка оплаты
# ============================================================
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=


# ============================================================
# Токены и бонусы (опционально, есть дефолты)
# ============================================================

# Стоимость генерации в токенах
TOKENS_2K=10
TOKENS_4K=20

# Бонус за реферала
REFERRAL_BONUS_TOKENS=50
